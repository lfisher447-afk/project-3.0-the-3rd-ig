{
  "version": 2,
  "framework": null,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/sw-proxy.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/proxy", "destination": "/server.ts" },
    { "source": "/api/proxy/ping", "destination": "/server.ts" },
    { "source": "/api/health", "destination": "/server.ts" },
    { "source": "/api/nodes/status", "destination": "/server.ts" },
    { "source": "/api/audio/stream", "destination": "/server.ts" },
    { "source": "/api/video/stream", "destination": "/server.ts" },
    { "source": "/api/youtube/search", "destination": "/server.ts" },
    { "source": "/api/innertube/search", "destination": "/server.ts" },
    { "source": "/api/innertube/video-info", "destination": "/server.ts" },
    { "source": "/api/spotify/featured", "destination": "/server.ts" },
    { "source": "/api/spotify/search", "destination": "/server.ts" },
    { "source": "/api/spotify/resolve-playlist", "destination": "/server.ts" },
    { "source": "/api/auth/spotify/url", "destination": "/server.ts" },
    { "source": "/api/auth/spotify/token", "destination": "/server.ts" },
    { "source": "/api/invidious/trending", "destination": "/server.ts" },
    { "source": "/api/invidious/comments", "destination": "/server.ts" },
    { "source": "/api/invidious/instances", "destination": "/server.ts" },
    { "source": "/api/ai/oracle", "destination": "/api/ai-oracle" },
    { "source": "/api/ws-tunnel", "destination": "/server.ts" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
