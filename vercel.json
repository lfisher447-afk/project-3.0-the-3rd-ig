{
  "version": 2,
  "framework": null,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/sw-proxy.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/proxy", "dest": "/server.ts" },
    { "src": "/api/proxy/ping", "dest": "/server.ts" },
    { "src": "/api/health", "dest": "/server.ts" },
    { "src": "/api/nodes/status", "dest": "/server.ts" },
    { "src": "/api/audio/stream", "dest": "/server.ts" },
    { "src": "/api/video/stream", "dest": "/server.ts" },
    { "src": "/api/youtube/search", "dest": "/server.ts" },
    { "src": "/api/innertube/search", "dest": "/server.ts" },
    { "src": "/api/innertube/video-info", "dest": "/server.ts" },
    { "src": "/api/spotify/featured", "dest": "/server.ts" },
    { "src": "/api/spotify/search", "dest": "/server.ts" },
    { "src": "/api/spotify/resolve-playlist", "dest": "/server.ts" },
    { "src": "/api/auth/spotify/url", "dest": "/server.ts" },
    { "src": "/api/auth/spotify/token", "dest": "/server.ts" },
    { "src": "/api/invidious/trending", "dest": "/server.ts" },
    { "src": "/api/invidious/comments", "dest": "/server.ts" },
    { "src": "/api/invidious/instances", "dest": "/server.ts" },
    { "src": "/api/ai/oracle", "dest": "/server.ts" },
    { "src": "/api/ws-tunnel", "dest": "/server.ts" },
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ]
}
